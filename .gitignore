# Virtual environment
.venv/

# Python
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Raw data — queried in place from Hugging Face or regenerated by the SQL
# pipeline, never committed
data/raw/*
!data/raw/.gitkeep

# Extracted subsets and DuckDB files — large, regenerated by the pipeline
data/processed/*
!data/processed/.gitkeep
*.parquet
*.duckdb
*.duckdb.wal

# Secrets
.env

# OS
.DS_Store

# Claude
.claude/
CLAUDE.md
